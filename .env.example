# TaskBuddy — Environment Variables Overview
# Copy this file to backend/.env and frontend/.env as described below.
# See README.md for full setup instructions.

# ─────────────────────────────────────────────
# Backend  →  backend/.env
# ─────────────────────────────────────────────

# HTTP server port
PORT=5000

# MongoDB connection string (local or Atlas)
DATABASE_URL=mongodb://localhost:27017/taskbuddy

# JWT signing secret — use a long, random string in production
# Example: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_taskbuddy_2026

# Frontend origin — used for CORS and Socket.IO allowed origins
CLIENT_URL=http://localhost:5173

# ─────────────────────────────────────────────
# Frontend  →  frontend/.env
# ─────────────────────────────────────────────

# Backend REST API base URL (consumed by authFetch and taskService)
VITE_API_URL=http://localhost:5000/api

# Backend Socket.IO server URL (consumed by the Socket.IO singleton)
VITE_SOCKET_URL=http://localhost:5000
